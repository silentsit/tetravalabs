NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Use production Render URL when local Medusa is not running (npm run medusa:dev).
NEXT_PUBLIC_MEDUSA_URL=https://tetrava-medusa-i44n.onrender.com
# For fully local stack: NEXT_PUBLIC_MEDUSA_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
REVALIDATE_SECRET=
RESTRICTED_COUNTRIES=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Google Analytics 4 measurement ID (defaults to production property if unset)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-YZ9KZMZZLW
# Optional Organization schema sameAs profiles (verified live URLs only)
# NEXT_PUBLIC_TWITTER_URL=https://x.com/tetravalabs
# NEXT_PUBLIC_INSTAGRAM_URL=
# NEXT_PUBLIC_LINKEDIN_URL=
# NEXT_PUBLIC_FACEBOOK_URL=
# Optional: Coinbase Onramp app ID for branded US deep links (Tab B)
NEXT_PUBLIC_COINBASE_APP_ID=

SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2025-01-01
# Editor token for npm run sanity:seed (local only — do not expose to browser)
SANITY_API_WRITE_TOKEN=

# Typesense Cloud — for local `npm run typesense:index` only
TYPESENSE_PROTOCOL=https
TYPESENSE_HOST=
TYPESENSE_PORT=443
TYPESENSE_API_KEY=
TYPESENSE_COLLECTION=products
# Live search uses Medusa GET /store/search (Typesense env on Render Medusa).

# Comma-separated storefront admin emails allowed to post custom-name reviews and delete reviews.
NEXT_PUBLIC_STORE_ADMIN_EMAILS=info@tetravalabs.com,admin@tetravalabs.com

# Social sign-in — enable on storefront only after Medusa OAuth env vars are set (see apps/medusa/.env.example)
# NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=true
# NEXT_PUBLIC_AUTH_APPLE_ENABLED=true

RESEND_API_KEY=
RESEND_FROM=Tetrava Labs <orders@tetravalabs.com>
CONTACT_TO_EMAIL=info@tetravalabs.com

# AI research support chat (Vercel AI SDK)
# Prefer AI Gateway on Vercel; otherwise set OPENAI_API_KEY for local/dev.
OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini
# AI_CHAT_MODEL=openai/gpt-4o-mini
# AI_GATEWAY_API_KEY=
