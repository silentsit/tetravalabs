{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && corepack enable && npm ci",
  "buildCommand": "npm run build",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.tetravalabs.com" }],
      "destination": "https://tetravalabs.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.tetravalabs.com" }],
      "destination": "https://tetravalabs.com/:path*",
      "permanent": true
    },
    {
      "source": "/nad-plus",
      "destination": "/buy-nad-online",
      "statusCode": 301
    },
    {
      "source": "/nad%2B",
      "destination": "/buy-nad-online",
      "statusCode": 301
    },
    {
      "source": "/nadplus",
      "destination": "/buy-nad-online",
      "statusCode": 301
    },
    {
      "source": "/product/nad-plus",
      "destination": "/buy-nad-online",
      "statusCode": 301
    },
    {
      "source": "/products/nad-plus",
      "destination": "/buy-nad-online",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
        { "key": "X-DNS-Prefetch-Control", "value": "on" },
        {
          "key": "Link",
          "value": "</.well-known/api-catalog>; rel=\"api-catalog\", </openapi.json>; rel=\"service-desc\"; type=\"application/openapi+json\", </auth.md>; rel=\"describedby\"; type=\"text/markdown\", </sitemap_index.xml>; rel=\"sitemap\", </llms.txt>; rel=\"alternate\"; type=\"text/plain\""
        }
      ]
    },
    {
      "source": "/auth.md",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/openapi.json",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    }
  ]
}
